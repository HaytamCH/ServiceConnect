# Tag immutable produit par GitHub Actions (SHA complet du commit recommandé)
IMAGE_TAG=replace_with_the_git_commit_sha

# URL publique et port exposé par le frontend
APP_URL=http://SERVER_IP:8080
APP_PORT=8080

# Clé Laravel : générer avec `php artisan key:generate --show`
APP_KEY=base64:replace_with_a_generated_key

# Base MariaDB
DB_DATABASE=serviceconnect
DB_USERNAME=serviceconnect
DB_PASSWORD=replace_with_a_strong_password
DB_ROOT_PASSWORD=replace_with_another_strong_password

# Facultatif pour la démonstration des paiements Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Les e-mails restent volontairement écrits dans les logs Portainer
MAIL_FROM_ADDRESS=noreply@serviceconnect.local
