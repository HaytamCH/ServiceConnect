# Ports du déploiement Portainer
FRONTEND_PORT=8201
BACKEND_PORT=8200

# Application Laravel
APP_NAME=ServiceConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://serviceconnect.jobsacademie.tech
FRONTEND_URL=https://serviceconnect.jobsacademie.tech

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8.0. DB_HOST reste "database" dans les conteneurs.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=serviceconnect
DB_USERNAME=root
DB_PASSWORD=replace_with_a_strong_password
DB_ROOT_PASSWORD=replace_with_another_strong_password

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Les e-mails restent volontairement visibles dans les logs du backend.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@serviceconnect.local
MAIL_FROM_NAME=ServiceConnect

# Facultatif pour la démonstration Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Une URL relative permet au même build Vue de fonctionner derrière Nginx.
VITE_API_BASE_URL=/api/v1
